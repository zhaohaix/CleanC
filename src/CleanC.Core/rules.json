    "minAgeDays": 0,
    "risk": "A",
    "requiresAdmin": false,
    "defaultSelected": true,
    "requiresBrowserClosed": true,
    "browserProcess": "msedge",
    "reason": "浏览器缓存可重新下载，不包含书签和密码",
    "impact": "首次打开网页会稍慢，需要重新缓存",
    "recursive": true
  },
