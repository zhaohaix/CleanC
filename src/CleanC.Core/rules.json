[
  {
    "id": "temp.user",
    "name": "用户临时文件",
    "description": "当前用户 Temp 目录中 7 天前的临时文件",
    "root": "%TEMP%",
    "patterns": [ "*" ],
    "minAgeDays": 7,
    "risk": "A",
    "requiresAdmin": false,
    "defaultSelected": true,
    "reason": "可再生的临时文件，删除后由应用重新生成",
    "impact": "正在运行的安装程序可能失败，建议先退出",
    "recursive": true
  },
  {
    "id": "cache.thumbnails",
    "name": "缩略图与图标缓存",
    "description": "资源管理器生成的 thumbcache / iconcache 数据库",
    "root": "%LOCALAPPDATA%\\Microsoft\\Windows\\Explorer",
    "patterns": [ "thumbcache_*.db", "iconcache_*.db" ],
    "minAgeDays": 0,
    "risk": "A",
    "requiresAdmin": false,
    "defaultSelected": true,
    "reason": "缓存会自动重建，不包含个人文件",
    "impact": "首次打开文件夹会稍慢",
    "recursive": false
  },
  {
    "id": "cache.edge",
