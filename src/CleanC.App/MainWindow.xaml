<Window x:Class="CleanC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanC · C 盘清理"
        Width="1120"
        Height="850"
        MinWidth="920"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6F5"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="#E2EAE7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#145C53" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DDF0E9" />
            <Setter Property="Foreground" Value="#145C53" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EDF2F0" />
            <Setter Property="Foreground" Value="#61736E" />
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F8F7" />
            <Setter Property="Foreground" Value="#145C53" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#E2EAE7" />
        </Style>

        <Style x:Key="Cell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#145C53"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <TabControl Margin="0,8,0,0" Background="#F3F6F5" BorderThickness="0" Padding="0">
        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Padding" Value="22,10"/>
                <Setter Property="Foreground" Value="#145C53"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                    <Border x:Name="Tab" Background="#E8EFEB" CornerRadius="10,10,0,0" Padding="{TemplateBinding Padding}" Margin="8,0,0,0">
                        <ContentPresenter ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#145C53"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </TabControl.Resources>
        <TabItem Header="日常清理 · A 级">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="28,24" Margin="24,20,24,0" CornerRadius="20">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#123C37" Offset="0"/><GradientStop Color="#1B6B5D" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" Background="#2E7869" CornerRadius="14" Margin="0,0,14,0">
                            <TextBlock Text="C" FontFamily="Segoe UI" Foreground="#B9F3D9" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="CleanC" Foreground="White" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="让空间，轻一点。" Foreground="#BDDACF" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="用户缓存与临时文件清理" Foreground="#D8EAE3" FontSize="13" Margin="0,18,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="300">
                    <Border Background="#276C5F" CornerRadius="12" Padding="14,7" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding HeaderStatus}" Foreground="#D6F5E6" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="{Binding EnvironmentHint}" Foreground="#A9CFC0" FontSize="11" Margin="0,10,0,0" HorizontalAlignment="Right" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="C 盘可用空间" Foreground="#6B8078" FontSize="12" />
                    <TextBlock Text="{Binding FreeSpaceText}"
                               Foreground="#145C53"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding DriveSummary}"
                               Foreground="#81948C"
                               FontSize="11"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="本次已选空间" Foreground="#6B8078" FontSize="12" />
                    <TextBlock Text="{Binding SelectedText}"
                               Foreground="#16836A"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,4,0,0" />
                    <TextBlock Text="勾选后才会纳入本次操作"
                               Foreground="#81948C"
                               FontSize="11"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="当前状态" Foreground="#6B8078" FontSize="12" />
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#145C53"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="24,20,24,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="2,0,2,12">
                <TextBlock Text="清理项目" FontSize="17" FontWeight="SemiBold" Foreground="#183F35"/>
                <TextBlock Text="仅处理已扫描并勾选的文件" FontSize="11" Foreground="#81948C" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="重新扫描" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="模拟清理" ToolTip="只生成待删清单，不删除任何文件" Command="{Binding SimulateCleanCommand}" Style="{StaticResource SecondaryButton}"/>
                    <Button Content="执行清理" ToolTip="永久删除选中的缓存文件，执行前需要二次确认" Command="{Binding CleanCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource GhostButton}"/>

                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="日志目录" Command="{Binding OpenLogFolderCommand}" Style="{StaticResource GhostButton}"/>
                    <Button Content="复制路径" Command="{Binding CopyLogPathCommand}" Style="{StaticResource GhostButton}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="24,0,24,0">
            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EDF2EF"
                      RowHeaderWidth="0"
                      RowHeight="48"
                      Background="#FFFFFF"
                      BorderThickness="0"
                      AlternatingRowBackground="#FAFCFB"
                      ColumnHeaderStyle="{StaticResource ColumnHeader}"
                      CellStyle="{StaticResource Cell}">
                <DataGrid.RowStyle><Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#2C443B"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#ECF6F0"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DDEFE5"/><Setter Property="Foreground" Value="#145C53"/></Trigger>
                    </Style.Triggers>
                </Style></DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="48" Header="">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding CanSelect}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="清理项"
                                        Binding="{Binding Name}"
                                        Width="220"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="体积"
                                        Binding="{Binding SizeText}"
                                        Width="105"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="文件数"
                                        Binding="{Binding FileCountText}"
                                        Width="90"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="状态"
                                        Binding="{Binding StatusText}"
                                        Width="*"
                                        IsReadOnly="True"
                                        ElementStyle="{StaticResource CellText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Expander Grid.Row="4" Header="操作记录 · 仅保存在本机"
                  Margin="24,12,24,0"
                  IsExpanded="True"
                  Foreground="#145C53">
            <Border Background="#EAF0EC" CornerRadius="10" Padding="10" Height="100">
                <ListBox ItemsSource="{Binding LogLines}"
                         Background="Transparent"
                         Foreground="#51685D"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Border>
        </Expander>

        <Border Grid.Row="5"
                Background="#E8F1EB"
                BorderBrush="#D6E5DC"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="24,10,24,14">
            <TextBlock Text="安全边界：只处理白名单内的用户缓存；不清理回收站、系统目录、桌面、文档、下载；不请求管理员权限；默认只扫描，清理前需二次确认。"
                       Foreground="#5C7867"
                       FontSize="11"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
        </TabItem>
        <TabItem Header="需确认处理 · B 级">
            <Grid DataContext="{Binding Review}" Margin="24,20,24,18" TextElement.FontWeight="Normal">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#173F37" CornerRadius="18" Padding="24">
                    <StackPanel>
                        <TextBlock Text="B 级 · 占用扫描与系统工具" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="逐项查看影响，并从 Windows 或应用的官方入口处理。" Foreground="#BED8CB" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="涉及系统功能、恢复能力或个人数据；各项目占用分别展示，不合计为可清理空间。" Foreground="#BED8CB" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1" Margin="0,16,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Content="扫描 B 级项目" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Grid.Column="1" Content="取消扫描" Command="{Binding CancelCommand}" Style="{StaticResource GhostButton}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#61736E" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0,0,0"/>
                </Grid>
                <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0,12,0,0">
                    <TabControl.Resources>
                        <DataTemplate x:Key="ReviewCard">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,12" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="{Binding Name}" Foreground="#183F35" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SizeText}" Foreground="#16836A" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Scope}" Foreground="#81948C" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Impact}" Foreground="#93632C" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Guidance}" Foreground="#61736E" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding EntryLabel}" Command="{Binding OpenCommand}" Style="{StaticResource SecondaryButton}" Margin="0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </TabControl.Resources>
                    <TabItem Header="{Binding ScanTabTitle}">
                        <Grid TextElement.FontWeight="Normal">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="取得大小的项目在这里展示。首次扫描前显示待检查项；统计大小不等于可以全部删除。" Foreground="#61736E" Margin="4,0,4,12" TextWrapping="Wrap"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="尚未取得文件大小，请扫描或查看另一个页面中的具体原因。" Foreground="#61736E" Margin="12,20">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ScanItems.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding ScanItems}" ItemTemplate="{StaticResource ReviewCard}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{Binding ToolsTabTitle}">
                        <Grid TextElement.FontWeight="Normal">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="这里没有可确认的占用数值。每项分别说明未统计、访问受限或未发现目标；入口用于进一步查看和处理，不代表文件不能删除。" Foreground="#61736E" Margin="4,0,4,12" TextWrapping="Wrap"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ToolItems}" ItemTemplate="{StaticResource ReviewCard}"/>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </TabItem>
        <TabItem Header="C 盘空间与安装文件">
            <StackPanel Margin="32" TextElement.Foreground="#61736E" TextElement.FontWeight="Normal">
                <TextBlock Text="C 盘空间与安装文件" FontSize="26" Foreground="#145C53"/>
                <TextBlock Text="查看大目录、大文件，或选择下载目录和桌面的安装文件候选移入回收站。" Margin="0,16" TextWrapping="Wrap"/>
                <Button Content="打开空间分析" Click="OpenDisk_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="聊天只读连接">
            <StackPanel Margin="32" TextElement.Foreground="#61736E" TextElement.FontWeight="Normal">
                <TextBlock Text="QQ / 微信只读连接验证" FontSize="26" Foreground="#145C53"/>
                <TextBlock Text="先运行你现有的 SnowLuma 本机连接服务，再核对联系人、群号与选定会话的附件。" Margin="0,16" TextWrapping="Wrap"/>
                <Button Content="QQ：联系人与附件验证" Click="OpenQq_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                <Button Content="微信：联系人与群名验证" Click="OpenWeChat_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
